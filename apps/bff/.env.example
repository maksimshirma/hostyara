# Public listener (browser-facing, same origin as the shell) and internal
# listener (identity-service webhooks only — never expose it publicly).
PORT=4000
INTERNAL_PORT=4001

# Origin the browser uses for the shell. Optional, defaults to
# http://localhost:$PORT. In dev the host's Vite proxy serves the BFF under
# http://localhost:3000.
BFF_PUBLIC_URL=http://localhost:3000

# identity-service; run it with PORT=3001 locally — the host already owns :3000.
IDENTITY_URL=http://localhost:3001
# Must match this BFF's row in identity-service's `clients` table.
BFF_CLIENT_ID=hostyara-bff

# true only when the BFF runs behind our own reverse proxy: the browser IP is
# then taken from the last X-Forwarded-For entry (it is forwarded to
# identity-service, whose Better-Auth rate limits per IP).
TRUST_PROXY=false

# 32 random bytes, base64. Encrypts stored identity sessions at rest.
# Generate a real one with: openssl rand -base64 32
SESSION_ENC_KEY=ZGV2LW9ubHktaW5zZWN1cmUta2V5LTMyLWJ5dGVzISE=

POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=hostyara_bff
POSTGRES_USER=admin
POSTGRES_PASSWORD=super_secret_password

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=super_secret_password
PGADMIN_PORT=5050
# Only needed if you run several pgadmin servers
PGADMIN_CONFIG_SESSION_COOKIE_NAME="'bff_pga4_session'"